{
  "keym": {
    "layer": "segmentation",
    "tool": "calcadaMergeSegments"
  },
  "keyc": {
    "layer": "segmentation",
    "tool": "calcadaMulticutSegments"
  },
  "keyf": {
    "layer": "segmentation",
    "tool": "calcadaFindPath"
  },
  "keyp": {
    "layer": "segmentation",
    "tool": "calcadaPieceSplit"
  },
  "keyx": false,
  "control+shift+keyx": "clear-segments",
  "bracketleft": "select-previous",
  "bracketright": "select-next",
  "editSession": {
    "brush": "control+keyb",
    "erase": "control+keye",
    "fill": "control+keyf",
    "cursor": "control+keyv",
    "undo": ["control+keyz", "meta+keyz"],
    "redo": ["control+shift+keyz", "meta+shift+keyz"],
    "sizeDecrease": ["minus", "numpadsubtract"],
    "sizeIncrease": ["equal", "shift+equal", "numpadadd"],
    "valueDecrease": "bracketleft",
    "valueIncrease": "bracketright"
  }
}
