# Standalone / dev edit-session backend (TM-349).
# Copy to `.env` (gitignored) and fill in. All optional.
# Values are raw strings — do NOT wrap in quotes or JSON.stringify; the build
# stringifies them. An unset var is simply omitted (feature stays off).

# Root URL of the Zetta backend. The edit session's tools append their own API
# group, e.g. `/segmentation/propagate_mask`. Enables the compute + save
# backends standalone (no portal needed).
NEUROGLANCER_ZETTA_BACKEND_URL=https://web-api-dev-349854005841.us-east4.run.app

# Google login for an IAP-protected backend. When set, NG runs the browser
# Google OAuth flow (client id only, NO secret) and sends the OIDC id_token as
# the bearer. Its audience is this client id, which IAP validates. Takes
# precedence over NEUROGLANCER_ZETTA_BACKEND_TOKEN. The OAuth client must allow
# this app's origin + `/google_oauth2_redirect.html` redirect URI.
NEUROGLANCER_ZETTA_GOOGLE_CLIENT_ID_IAP=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Static bearer token — DEV ONLY (ships in the bundle, short-lived). Fallback
# when the Google client id above is not set. Include the "Bearer " prefix.
# NEUROGLANCER_ZETTA_BACKEND_TOKEN=Bearer eyJ...
